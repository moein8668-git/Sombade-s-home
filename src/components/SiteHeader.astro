---
import TopBar from './TopBar.astro';

interface Props {
  bannerSrc: string;
  bannerAlt: string;
  title: string;
  subtitle: string;
  brand?: string;
}

const {
  bannerSrc,
  bannerAlt,
  title,
  subtitle,
  brand = "Sombade's Tutorials",
} = Astro.props;
---
<header>
  <img src={bannerSrc} alt={bannerAlt} class="banner" loading="eager" fetchpriority="high" />
  <div class="banner-overlay"></div>
  <TopBar brand={brand} active="/tutorials" />
  <div class="hero-content">
    <nav class="breadcrumb" aria-label="مسیر">
      <a href="/">خانه</a> <span class="sep">/</span>
      <a href="/tutorials">آموزش‌ها</a> <span class="sep">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>
  </div>
</header>
